# Copy to .env.local (not committed) and fill in for your own setup. deploy/deploy.sh copies it to the
# server with the app; the server, the build and the tests all read it.

# The machine Hermes runs on, as you reach it over ssh, and where the app is copied there.
HM_DEPLOY_HOST=server.your-tailnet.ts.net
HM_REMOTE_DIR=src/hermes-mobile
# The tailnet https port tailscale serve exposes the app on.
HM_PUBLIC_PORT=8620

# The address the phone opens (tailscale serve does not pass the browser's Host header).
HM_PUBLIC_ORIGIN=https://server.your-tailnet.ts.net:8620
# Who may connect: the tailnet login, and the devices by MagicDNS name (never the server itself).
HM_ALLOWED_LOGINS=you@example.com
HM_ALLOWED_DEVICES=your-phone.your-tailnet.ts.net,your-pc.your-tailnet.ts.net

# What the app calls the server ("Hermes is on ..."); "the server" when unset.
VITE_HM_SERVER_NAME=

# Tests: any checkout with Playwright installed (its package.json), and the deployed app's address.
HM_PLAYWRIGHT_FROM=/path/to/a/project/with/playwright/package.json
HM_BASE=https://server.your-tailnet.ts.net:8620/
